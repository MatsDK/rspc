{
	"name": "@rspc/client",
	"version": "0.3.1",
	"description": "A blazing fast and easy to use TRPC-like server for Rust.",
	"keywords": [],
	"author": "Oscar Beaumont",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.cjs"
		},
		"./next": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.cjs"
		},
		"./legacy": {
			"types": "./dist/legacy/index.d.ts",
			"import": "./dist/legacy/index.js",
			"default": "./dist/legacy/index.cjs"
		}
	},
	"files": ["dist"],
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"prepare": "tsup"
	},
	"devDependencies": {
		"tsup": "^8.3.6",
		"typescript": "^5.7.3"
	},
	"tsup": {
		"entry": ["src/index.ts", "src/legacy/index.ts"],
		"format": ["esm", "cjs"],
		"dts": true,
		"splitting": true,
		"clean": true,
		"sourcemap": true
	},
	"dependencies": {
		"vitest": "^3.0.5"
	}
}
